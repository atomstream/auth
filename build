#!/usr/bin/env -S clojure -A:tools.build -J-Dclojure.main.report=stderr -M

(ns oak.bin.build
  (:require
   [clojure.java.io :as io]
   [clojure.java.shell :as sh]
   [clojure.tools.build.api :as build]
   [lambdaisland.cli :as cli]
   [lambdaisland.ornament :as o]
   [co.gaiwan.oak.app.config :as config]
   [org.corfield.log4j2-conflict-handler :refer [log4j2-conflict-handler]]))

(def init {})

(defn write-styles
  "Compile Ornament styles down to target/oak/styles.css"
  {:flags ["--target-dir" {:doc "Target directory" :default "target"}]}
  [{:keys [target-dir]}]
  (let [f (io/file target-dir "oak/assets/styles.css")]
    (.mkdirs (io/file (.getParent f)))
    (config/load!)
    (println "   --> Wrote" (str f) (count (o/defined-styles)) "bytes <--")
    (spit f (o/defined-styles))))

(defn uberjar
  "Build uberjar"
  {:flags ["--target-dir" {:doc "Target directory" :default "target"}]}
  [{:keys [target-dir] :as opts}]
  (let [basis (build/create-basis {:project "deps.edn"})
        h #(println "-=>=- " % " -=<=-")]
    (h "Cleaning target/")
    (sh/sh "sh" "-c" (str "rm  -rf " target-dir "/*"))

    (h "Writing oak/assets/styles.css")
    (write-styles opts)

    (h "Copying resources/* to target/")
    (build/copy-dir {:src-dirs   ["resources"]
                     :target-dir target-dir})

    (h "Compiling Clojure")
    (build/compile-clj {:basis        basis
                        :src-dirs     ["src"]
                        :class-dir    target-dir
                        :compile-opts {:elide-meta [:doc]}})

    (h "Building target/oak-uberjar.jar")
    (build/uber {:class-dir         target-dir
                 :uber-file         (str target-dir "/oak-uberjar.jar")
                 :basis             basis
                 :main              'co.gaiwan.oak.app.admin-cli
                 :conflict-handlers log4j2-conflict-handler})

    (println "[Ready.]")
    (System/exit 0)))

(def commands
  ["uberjar" #'uberjar
   "write-styles" #'write-styles])

(def flags
  ["-v, --verbose" "Increase verbosity"
   "-h, --help" "Show help text for a (sub-)command"])

(cli/dispatch*
 {:name "bin/build"
  :init init
  :flags flags
  :commands commands})

;; Local Variables:
;; mode:clojure
;; End:
